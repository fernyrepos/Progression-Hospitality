<Operation Class="PatchOperationFindMod">
		<mods>
			<li>ReBuild: Doors and Corners</li>
		</mods>
		<match Class="PatchOperationSequence">
    <operations>

        <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[@Name="Museums_GlassWall"]/designationCategory</xpath>
            <value>
                <designationCategory>Ferny_Hosting</designationCategory>
            </value>
        </li>
        <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[@Name="Museums_GlassWall"]/designationCategory</xpath>
            <value>
                <designationCategory>Ferny_Hosting</designationCategory>
            </value>
        </li>
        <li Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[@Name="Museums_GlassWall"]</xpath>
            <value>
                <researchPrerequisites><li>Ferny_Museums</li></researchPrerequisites>
            </value>
        </li>
        <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="Museums_GlassWall"]/label</xpath>
            <value>
                <label>observation glass wall</label>
            </value>
        </li>
        <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="Museums_GlassWall"]/costList</xpath>
            <value>
                    <costList>
                        <RB_Glass>5</RB_Glass>
                    </costList>
            </value>
        </li>
        <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="Museums_ReinforcedGlassWall"]/label</xpath>
            <value>
                    <label>reinforced observation glass wall</label>
            </value>
        </li>
        <li Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="Museums_ReinforcedGlassWall"]/costList</xpath>
            <value>
                    <costList>
                        <Steel>10</Steel>
                        <RB_Glass>10</RB_Glass>
                    </costList>
            </value>
        </li>

    </operations>
		</match>
	</Operation>

